# Lectra environment configuration
# Copy this file to .env and fill in your real values.
#
# IMPORTANT: Never commit the .env file to version control.

SUPABASE_URL=YOUR_SUPABASE_URL
# For a trusted server-side app you may use either the anon key or the
# service_role key. If you use the anon key, make sure Row Level Security
# (RLS) is disabled on all tables in the Supabase dashboard.
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY

# Browser push notifications via OneSignal.
# App ID and REST API Key from the OneSignal dashboard (Settings > Keys & IDs).
# Pushes are scheduled with send_after, so OneSignal delivers them even when
# the web service is asleep (e.g. Render's free tier).
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=YOUR_ONESIGNAL_REST_API_KEY
