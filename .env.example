# Lectra environment configuration
# Copy this file to .env and fill in your real values.
#
# IMPORTANT: Never commit the .env file to version control.

SUPABASE_URL=YOUR_SUPABASE_URL
# For a trusted server-side app you may use either the anon key or the
# service_role key. If you use the anon key, make sure Row Level Security
# (RLS) is disabled on all tables in the Supabase dashboard.
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY

# Browser push notifications. Generate one VAPID key pair for the deployment
# and keep it stable; see the pywebpush documentation for your key tool.
VAPID_PUBLIC_KEY=BIsYp4YWISd7N8fnPygw6KOGCf0M2tgNnRXChehXNuwG6BIvi_we4Ig6VJvKhixtlcuR2AWtrLlxAP-zc5HZCRg
